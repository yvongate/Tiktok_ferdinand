# Cle API KIE.AI (obligatoire en production - le script Python la lit depuis
# cette variable ; en local il sait aussi retomber sur un fichier api.txt).
KIE_API_KEY=

# Port d'ecoute du backend
PORT=3000

# Origine autorisee pour CORS (URL du frontend)
FRONT_ORIGIN=http://localhost:5173

# Jeton exige pour LANCER ou SUPPRIMER une generation. Le front doit envoyer
# la meme valeur dans VITE_API_TOKEN (elle est figee dans son bundle a la
# compilation : changer le jeton demande de redeployer les deux).
# Obligatoire en production - sans lui, toutes les ecritures sont refusees,
# parce qu'une API ouverte laisse un inconnu depenser les credits KIE.AI.
# Facultatif en local.
API_TOKEN=

# Binaire Python : "python" sous Windows, generalement "python3" sous Linux/Docker
PYTHON_BIN=python

# Force UN script pour tous les jobs, quel que soit leur format. Reserve aux
# tests (mock) : en production, la laisser vide pour que le backend choisisse
# generate.py (format ferdinand) ou graphique.py (format graphique).
# PYTHON_SCRIPT_PATH=

# Dossier de stockage des jobs et des videos generees (defaut : back/data).
# En production sur Render : pointer vers un disque persistant, sinon les
# videos sont perdues a chaque redeploiement.
# DATA_DIR=/var/data

# Pseudo incruste en filigrane mobile sur chaque video (ex. @darum.finanzen).
# Laisser VIDE tant que le nom de compte n'est pas fixe : aucun filigrane
# n'est alors incruste. Changer cette valeur ne demande aucun rebuild de
# l'image Docker, juste un redemarrage du service.
WATERMARK=
